---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/layout.css';
import '../styles/content.css';
import '../styles/print.css';

interface Props { lang: 'es' | 'en'; strings: any; other: string }
const { lang, strings, other } = Astro.props;
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{strings.htmlTitle}</title>
  <meta name="description" content={strings.dek} />
  <link rel="alternate" hreflang={lang === 'es' ? 'en' : 'es'} href={other} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&family=IBM+Plex+Mono:wght@400;500&display=swap"
    rel="stylesheet"
  />
</head>
<body>
  <header class="masthead">
    <div>
      <a class="lang-switch" href={other} hreflang={lang === 'es' ? 'en' : 'es'}>{strings.switchTo}</a>
      <p class="eyebrow">{strings.eyebrow}</p>
      <h1>{strings.title}</h1>
      <p class="dek">{strings.dek}</p>
      <div class="meta">
        {strings.meta.map(([k, v]: [string, string]) => <div>{k}<strong>{v}</strong></div>)}
      </div>
    </div>
  </header>

  <div class="shell">
    <slot name="toc" />
    <main><slot /></main>
  </div>

  <footer class="site-footer">
    <div>{strings.footer.map((p: string) => <p>{p}</p>)}</div>
  </footer>

  <script>
    // Conserva el ancla al cambiar de idioma: #c5 y #e5 son el mismo capítulo.
    document.querySelector('.lang-switch')?.addEventListener('click', (e) => {
      const a = e.currentTarget as HTMLAnchorElement;
      const id = location.hash.slice(1);
      if (id) a.href = a.getAttribute('href') + '#' + id;
    });
  </script>
</body>
</html>
